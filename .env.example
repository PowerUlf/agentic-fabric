# Copy to .env and fill in. .env is gitignored.

# --- Microsoft Entra / Fabric -------------------------------------------------
# Required for the headless REST transport (service principal, client credentials).
# The interactive MCP transport uses a browser OAuth flow and needs none of these.
AFABRIC_TENANT_ID=
AFABRIC_CLIENT_ID=
AFABRIC_CLIENT_SECRET=

# Fabric API scope. Only change this for sovereign clouds.
AFABRIC_SCOPE=https://api.fabric.microsoft.com/.default

# Fabric Core MCP Server (remote, preview).
AFABRIC_MCP_ENDPOINT=https://api.fabric.microsoft.com/v1/mcp/core

# Default transport for tool calls: "mcp" (interactive) or "rest" (unattended).
AFABRIC_TRANSPORT=mcp

# --- Agent loop ---------------------------------------------------------------
ANTHROPIC_API_KEY=
AFABRIC_MODEL=claude-sonnet-5

# --- Kernel -------------------------------------------------------------------
# Append-only audit journal.
AFABRIC_JOURNAL_PATH=.afabric/journal.jsonl
# Refuse any run that would produce more than this many changes at once.
AFABRIC_MAX_BLAST_RADIUS=25
