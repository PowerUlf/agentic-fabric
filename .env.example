# Copy to .env and fill in. .env is gitignored.

# --- Microsoft Entra / Fabric -------------------------------------------------
# Required for the headless REST transport (service principal, client credentials).
# The interactive MCP transport uses a browser OAuth flow and needs none of these.
AFABRIC_TENANT_ID=
AFABRIC_CLIENT_ID=
AFABRIC_CLIENT_SECRET=

# Fabric API scope. Only change this for sovereign clouds.
AFABRIC_SCOPE=https://api.fabric.microsoft.com/.default

# Fabric Core MCP Server (remote, preview).
AFABRIC_MCP_ENDPOINT=https://api.fabric.microsoft.com/v1/mcp/core

# Default transport for tool calls: "mcp" (interactive) or "rest" (unattended).
AFABRIC_TRANSPORT=mcp

# How the interactive sign-in is cached: auto | encrypted | unencrypted | none.
# "auto" prefers an encrypted cache and falls back to plaintext (with a warning)
# where no keyring is available, as on a headless VM. "none" signs in every time.
AFABRIC_TOKEN_CACHE=auto

# --- Agent loop ---------------------------------------------------------------
# The agent runs on the Claude Agent SDK and signs in like Claude Code: log in once
# with `claude` using your Claude plan, or on a headless machine export a token from
# `claude setup-token` as CLAUDE_CODE_OAUTH_TOKEN. Both must be in the shell
# environment — this file is not exported to the SDK.
# An ANTHROPIC_API_KEY in the environment wins over the plan and is billed per use.
AFABRIC_MODEL=claude-sonnet-5

# --- Kernel -------------------------------------------------------------------
# Append-only audit journal.
AFABRIC_JOURNAL_PATH=.afabric/journal.jsonl
